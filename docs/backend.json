{
  "entities": {
    "Block": {
      "title": "Block",
      "description": "Blok dalam Ledger EASTCHAIN (Ledger Layer).",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "timestamp": { "type": "number" },
        "prevHash": { "type": "string" },
        "hash": { "type": "string" },
        "minerAddress": { "type": "string" },
        "reward": { "type": "number" },
        "data": { "type": "object" }
      },
      "required": ["index", "timestamp", "prevHash", "hash", "minerAddress", "reward"]
    },
    "StakeRecord": {
      "title": "StakeRecord",
      "description": "Catatan bukti staking di Ledger Layer (Backend 2).",
      "type": "object",
      "properties": {
        "tgId": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "number" },
        "lockedUntil": { "type": "number" },
        "hash": { "type": "string" }
      },
      "required": ["tgId", "amount", "timestamp", "lockedUntil", "hash"]
    },
    "ChainState": {
      "title": "ChainState",
      "description": "Status global jaringan (Ledger Layer).",
      "type": "object",
      "properties": {
        "totalSupply": { "type": "number" },
        "mintedMining": { "type": "number", "description": "Total EAST dari Mining bucket." },
        "mintedStaking": { "type": "number", "description": "Total EAST dari Staking/APY bucket." },
        "mintedTreasury": { "type": "number" },
        "blockCount": { "type": "number" },
        "lastBlockHash": { "type": "string" },
        "lastPrunedIndex": { "type": "number" },
        "status": { 
          "type": "string", 
          "enum": ["active", "halted", "recovering"],
          "description": "Status operasional jaringan."
        }
      },
      "required": ["totalSupply", "blockCount", "lastBlockHash", "status"]
    },
    "IdentityMapping": {
      "title": "IdentityMapping",
      "description": "Mapping Telegram ID ke Address Kriptografi (Identity Layer).",
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "tgId": { "type": "string" },
        "username": { "type": "string" },
        "balance": { "type": "number" },
        "stakedAmount": { "type": "number" },
        "eastpassTier": { "type": "number" },
        "lastActive": { "type": "number" },
        "stakeLockedUntil": { "type": "number" },
        "isFounder": { "type": "boolean", "description": "Flag identitas Founder yang diset oleh server." }
      },
      "required": ["address", "tgId", "balance"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/ledger/main/blocks/{blockId}": {
      "schema": "Block",
      "description": "Ledger Aktif (Backend 2) - Data < 30 hari."
    },
    "/ledger/main/stakes/{stakeId}": {
      "schema": "StakeRecord",
      "description": "Bukti Staking (Backend 2)."
    },
    "/ledger/main/state/global": {
      "schema": "ChainState",
      "description": "Global State Jaringan."
    },
    "/identity/registry/users/{tgId}": {
      "schema": "IdentityMapping",
      "description": "Identity Layer & Balance (Backend 1)."
    }
  }
}
